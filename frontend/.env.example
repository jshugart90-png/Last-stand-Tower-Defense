EXPO_PUBLIC_BACKEND_URL=https://your-backend-url.example.com

# --- AdMob ad unit IDs (create in AdMob > Apps > Ad units). Leave blank to serve Google TEST ads.
# The AdMob *App* IDs are set in app.json (react-native-google-mobile-ads plugin), not here.
EXPO_PUBLIC_ADMOB_IOS_BANNER=
EXPO_PUBLIC_ADMOB_IOS_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_IOS_REWARDED=
EXPO_PUBLIC_ADMOB_ANDROID_BANNER=
EXPO_PUBLIC_ADMOB_ANDROID_INTERSTITIAL=
EXPO_PUBLIC_ADMOB_ANDROID_REWARDED=
# Set to 1 to force Google test ads in a release build (e.g. TestFlight QA).
EXPO_PUBLIC_ADMOB_TEST_ADS=
